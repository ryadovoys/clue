    "anima.js",
    "serve.cjs",
    "vite.js"
  ],
  "peerDependencies": {
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "bin": {
    "clue-serve": "serve.cjs"
  }
}
